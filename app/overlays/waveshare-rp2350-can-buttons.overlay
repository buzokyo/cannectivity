#include <zephyr/dt-bindings/gpio/gpio.h>

/*
 * Waveshare RP2350-CAN virtual button wiring example.
 * This is a reference overlay, not automatically selected by the build.
 * Verify pins against the active board DTS and your connected hardware.
 */
/ {
    aliases {
        yfa-button0 = &yfa_button_0;
        yfa-button1 = &yfa_button_1;
        yfa-button2 = &yfa_button_2;
        yfa-button3 = &yfa_button_3;
        yfa-button4 = &yfa_button_4;
        yfa-button5 = &yfa_button_5;
        yfa-button6 = &yfa_button_6;
        yfa-button7 = &yfa_button_7;
    };
    yfa_button_0: yfa_button_0 { gpios = <&gpio0 16 GPIO_ACTIVE_LOW>; };
    yfa_button_1: yfa_button_1 { gpios = <&gpio0 17 GPIO_ACTIVE_LOW>; };
    yfa_button_2: yfa_button_2 { gpios = <&gpio0 18 GPIO_ACTIVE_LOW>; };
    yfa_button_3: yfa_button_3 { gpios = <&gpio0 19 GPIO_ACTIVE_LOW>; };
    yfa_button_4: yfa_button_4 { gpios = <&gpio0 20 GPIO_ACTIVE_LOW>; };
    yfa_button_5: yfa_button_5 { gpios = <&gpio0 21 GPIO_ACTIVE_LOW>; };
    yfa_button_6: yfa_button_6 { gpios = <&gpio0 22 GPIO_ACTIVE_LOW>; };
    yfa_button_7: yfa_button_7 { gpios = <&gpio0 26 GPIO_ACTIVE_LOW>; };
};
